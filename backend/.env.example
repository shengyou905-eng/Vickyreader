PORT=3000
HOST=127.0.0.1
NODE_ENV=development

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

DATABASE_URL=postgres://postgres:postgres@localhost:5432/reader
CORS_ORIGIN=http://localhost:3000

# Obsidian Sync is disabled until migration 007 has been applied.
# A separate random server-only cursor signing secret (at least 32 characters).
OBSIDIAN_SYNC_ENABLED=false
OBSIDIAN_SYNC_CURSOR_SECRET=
# Exact allowlist. HTTP loopback callbacks are accepted only outside production.
OBSIDIAN_SYNC_REDIRECT_URIS=obsidian://zhidu-sync

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
SUPPORT_EMAIL=2931952407@qq.com
PRIVACY_EMAIL=2931952407@qq.com
# Required before App Store submission. Use the legal name registered on the
# Apple Developer account, or the full registered company name.
LEGAL_OPERATOR_NAME=
LEGAL_EFFECTIVE_DATE=2026-08-10
LEGAL_POLICY_VERSION=1.0
# Comma-separated terms that should be rejected from public posts/comments.
COMMUNITY_BLOCKED_TERMS=

# Optional: public origin used to build uploaded file URLs.
# Production example: https://api.youxugarden.com
PUBLIC_BASE_URL=

# Sign in with Apple. Keep the real private key and encryption key only in the
# production environment; never commit them or bundle them with Flutter.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.youxugarden.zhireader
# Comma-separated audiences when both native App IDs and Services IDs are used.
APPLE_ALLOWED_AUDIENCES=com.youxugarden.zhireader
# PEM content with line breaks escaped as \n.
APPLE_PRIVATE_KEY=
# Base64-encoded 32-byte key used to encrypt Apple refresh tokens at rest.
APPLE_TOKEN_ENCRYPTION_KEY=

# Optional MCP v0.1. This HMAC secret must be unique, random, and remain only
# on the server. It hashes custom read-only MCP access tokens.
MCP_TOKEN_HASH_SECRET=
MCP_TOKEN_TTL_DAYS=90

# Apple IAP (separate from Sign in with Apple). Apply 008 + 009 before enabling.
# TestFlight uses Sandbox. Use a separate deployment/DB/credentials for each environment.
APPLE_IAP_ENABLED=false
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_IAP_BUNDLE_ID=com.youxugarden.zhireader
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Server-only App Store Connect In-App Purchase API key, PEM with escaped \n.
APPLE_IAP_PRIVATE_KEY=
# Numeric App Store app ID; required for Production.
APPLE_IAP_APP_APPLE_ID=
# Semicolon-separated absolute paths to official Apple PKI root certificates (DER).
# Public certificates only; never use generated test roots in a deployed server.
APPLE_IAP_ROOT_CA_PATHS=
