PORT=3000
HOST=127.0.0.1
NODE_ENV=development

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

DATABASE_URL=postgres://postgres:postgres@localhost:5432/reader
CORS_ORIGIN=http://localhost:3000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
SUPPORT_EMAIL=2931952407@qq.com
PRIVACY_EMAIL=2931952407@qq.com
# Required before App Store submission. Use the legal name registered on the
# Apple Developer account, or the full registered company name.
LEGAL_OPERATOR_NAME=
LEGAL_EFFECTIVE_DATE=2026-08-10
LEGAL_POLICY_VERSION=1.0
# Comma-separated terms that should be rejected from public posts/comments.
COMMUNITY_BLOCKED_TERMS=

# Optional: public origin used to build uploaded file URLs.
# Production example: https://api.youxugarden.com
PUBLIC_BASE_URL=

# Sign in with Apple. Keep the real private key and encryption key only in the
# production environment; never commit them or bundle them with Flutter.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.youxugarden.zhireader
# Comma-separated audiences when both native App IDs and Services IDs are used.
APPLE_ALLOWED_AUDIENCES=com.youxugarden.zhireader
# PEM content with line breaks escaped as \n.
APPLE_PRIVATE_KEY=
# Base64-encoded 32-byte key used to encrypt Apple refresh tokens at rest.
APPLE_TOKEN_ENCRYPTION_KEY=
