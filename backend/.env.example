PORT=3000
HOST=127.0.0.1
NODE_ENV=development

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

DATABASE_URL=postgres://postgres:postgres@localhost:5432/reader
CORS_ORIGIN=http://localhost:3000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
SUPPORT_EMAIL=2931952407@qq.com
PRIVACY_EMAIL=2931952407@qq.com
# Required before App Store submission. Use the legal name registered on the
# Apple Developer account, or the full registered company name.
LEGAL_OPERATOR_NAME=
LEGAL_EFFECTIVE_DATE=2026-08-10
LEGAL_POLICY_VERSION=1.0
# Comma-separated terms that should be rejected from public posts/comments.
COMMUNITY_BLOCKED_TERMS=

# Optional: public origin used to build uploaded file URLs.
# Production example: https://api.youxugarden.com
PUBLIC_BASE_URL=

# Password reset email. The link sent to users must be HTTPS.
PASSWORD_RESET_PUBLIC_URL=https://api.example.com/auth/reset-password
PASSWORD_RESET_RATE_LIMIT_SECRET=replace-with-an-independent-long-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ReadU <no-reply@example.com>

# Sign in with Apple. Keep the .p8 contents and encryption key on the server.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.reader.aiReader
# Optional comma-separated audiences when multiple Apple client IDs are valid.
APPLE_ALLOWED_AUDIENCES=com.reader.aiReader
# Paste the .p8 PEM with literal \\n sequences between lines.
APPLE_PRIVATE_KEY=
# Generate with: openssl rand -base64 32
APPLE_TOKEN_ENCRYPTION_KEY=
